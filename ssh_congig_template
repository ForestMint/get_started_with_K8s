# /etc/ssh/sshd_config - minimal password login setup

Port 22
Protocol 2

# Allow password-based login
PasswordAuthentication yes
ChallengeResponseAuthentication no
UsePAM yes

# (Optional but recommended as giving root the possibility to SSH directly is widely considered a security risk)
PermitRootLogin prohibit-password
# PermitRootLogin no

# Allow both IPv4 and IPv6
AddressFamily any

# Authentication methods
PubkeyAuthentication yes

# Allow all system users (or specify users explicitly)
# AllowUsers alice

# Logging
LogLevel INFO