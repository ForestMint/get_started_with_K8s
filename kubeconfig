apiVersion: v1
kind: Config

# Define clusters you can connect to
clusters:
- name: dev-cluster
  cluster:
    server: https://dev.example.com:6443      # Kubernetes API server endpoint
    certificate-authority: /home/user/.kube/dev-ca.crt  # or use certificate-authority-data

- name: prod-cluster
  cluster:
    server: https://prod.example.com:6443
    certificate-authority-data: LS0tLS1CRUdJTiBDRVJUSUZJQ0...  # base64-encoded CA cert

# Define user credentials
users:
- name: dev-user
  user:
    client-certificate: /home/user/.kube/dev-user.crt
    client-key: /home/user/.kube/dev-user.key

- name: prod-user
  user:
    token: eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9...   # or use client-certificate / key

# Define contexts (cluster + user + namespace)
contexts:
- name: dev
  context:
    cluster: dev-cluster
    user: dev-user
    namespace: dev-namespace

- name: prod
  context:
    cluster: prod-cluster
    user: prod-user
    namespace: production

# Specify which context is used by default
current-context: dev